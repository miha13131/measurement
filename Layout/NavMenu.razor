        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="boxplot">
                Boxplot
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="stacked-bar">
                Stacked bar
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sunburst">
