@page "/pie"
@inject HttpClient Http
@inject IJSRuntime JS

@using DeviceMeasurementsApp.Models
@using DeviceMeasurementsApp.Services

<h3>Interaktivní kalkulačka podílů</h3>

<p style="margin-bottom:10px; max-width:1100px;">
    Podíl(t) = Metrika_i(t) / ΣMetrika_j(t) × 100 %. Podpora vlastních časových oken.
</p>

<div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:8px;">
    <button @onclick="LoadAndDraw">Načíst + vykreslit</button>

    <label>Metrika:</label>
    <select @onchange="OnMetricChanged" disabled="@(meters.Count == 0 || IsSpecialAgg)">
        @foreach (var m in metricOptions)
        {
            <option value="@m.Key" selected="@(m.Key == selectedMetric)">@m.Label</option>
        }
    </select>

    <label>Režim agregace:</label>
    <select @onchange="OnAggChanged" disabled="@(meters.Count == 0)">
        @foreach (var a in aggregationOptions)
        {
            <option value="@a.Key" selected="@(a.Key == selectedAgg)">@a.Label</option>
        }
    </select>

    <button @onclick="AddWindow" disabled="@(meters.Count == 0)">+ Přidat okno</button>
    <button @onclick="DrawAll" disabled="@(meters.Count == 0)">Přepočítat</button>
</div>

@if (meters.Count > 0)
{
    <div style="margin-bottom:10px; border:1px solid #d6d9df; background:#fafafa; padding:10px;">
        <strong>Časová okna:</strong>

        @foreach (var window in windows)
        {
            <div @key="window.Id" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:8px;">
                <label>Název:</label>
                <input style="min-width:120px;" @bind="window.Title" @bind:event="oninput" />

                <label>Od:</label>
                <input type="datetime-local" @bind="window.From" />

                <label>Do:</label>
                <input type="datetime-local" @bind="window.To" />

                <button @onclick="(() => RemoveWindow(window.Id))" disabled="@(windows.Count <= 1)">Odebrat</button>
            </div>
        }
    </div>
}

@if (meters.Count > 0)
{
    <div style="margin-bottom:10px;">
        <strong>Vybrané zdroje celkem:</strong>
        @foreach (var meter in meters)
        {
            <label style="margin-right:12px; margin-left:8px;">
                <input type="checkbox" checked="@meter.Enabled" @onchange="(e => ToggleMeter(meter.Id, (bool?)e.Value == true))" />
                @meter.Name
            </label>
        }
    </div>
}

@if (meters.Count > 0)
{
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:10px; margin-bottom:10px;">
        @foreach (var window in windows)
        {
            <div @key="window.Id" style="height:380px; border:1px solid #d6d9df; background:#fafafa; padding:8px;">
                <canvas id="@GetCanvasId(window.Id)"></canvas>
            </div>
        }
    </div>
}

@if (tableRows.Count > 0)
{
    <h5>Tabulka výsledků</h5>
    <div style="overflow:auto; max-height:340px; border:1px solid #ddd; background:white;">
        <table class="table table-sm table-striped" style="margin-bottom:0;">
            <thead>
                <tr>
                    <th>Okno</th>
                    <th>Od</th>
                    <th>Do</th>
                    <th>Položka</th>
                    <th>Agregace</th>
                    <th>Podíl %</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in tableRows)
                {
                    <tr>
                        <td>@row.WindowLabel</td>
                        <td>@row.From.ToString("MM-dd HH:mm")</td>
                        <td>@row.To.ToString("MM-dd HH:mm")</td>
                        <td>@row.ItemName</td>
                        <td>@row.AggregatedValue.ToString("0.###")</td>
                        <td>@row.SharePercent.ToString("0.##")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (whatIfRows.Count > 0)
{
    <h5 style="margin-top:10px;">Výsledky podmínek</h5>
    <div style="overflow:auto; max-height:240px; border:1px solid #ddd; background:white;">
        <table class="table table-sm table-striped" style="margin-bottom:0;">
            <thead>
                <tr>
                    <th>Okno</th>
                    <th>Podmínka</th>
                    <th>Intervaly</th>
                    <th>Minuty</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in whatIfRows)
                {
                    <tr>
                        <td>@row.WindowLabel</td>
                        <td>@row.Condition</td>
                        <td>@row.Intervals</td>
                        <td>@row.Minutes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed record Rec(int Id, string Name);
    private sealed record MetricOption(string Key, string Label);
    private sealed record AggOption(string Key, string Label);
    private sealed record ShareTableRow(string WindowLabel, DateTime From, DateTime To, string ItemName, double AggregatedValue, double SharePercent);
    private sealed record WhatIfRow(string WindowLabel, string Condition, int Intervals, int Minutes);

    private sealed class WindowConfig
    {
        public required string Id { get; init; }
        public string Title { get; set; } = string.Empty;
        public DateTime From { get; set; }
        public DateTime To { get; set; }
    }

    private sealed class MeterData
    {
        public int Id { get; init; }
        public string Name { get; init; } = string.Empty;
        public bool Enabled { get; set; } = true;
        public required UniArchTable Table { get; init; }
        public required Dictionary<string, int> IndexByName { get; init; }
        public required Dictionary<string, int> NormalizedIndexByName { get; init; }
    }

    private readonly List<Rec> recs =
    [
        new(58, "EMI1"),
        new(60, "EMI2"),
        new(59, "EMI3"),
        new(1, "MAIN")
    ];

    private readonly List<MetricOption> metricOptions =
    [
        new("P_avg_3P", "Činný výkon celkem"),
        new("S_avg_3S", "Zdánlivý výkon celkem"),
        new("Q_avg_3Q", "Jalový výkon celkem"),
        new("I_avg_mean", "Proud – průměr 3 fází"),
        new("P_to_S_ratio", "Poměr zatížení výkonu (P/S)"),
        new("S_from_PQ", "Zdánlivý výkon z P/Q"),
        new("Q_to_P_ratio", "Poměr jalového ku činnému (|Q|/P)"),
        new("PQ_incident_flag", "Příznak incidentu kvality energie")
    ];

    private readonly List<AggOption> aggregationOptions =
    [
        new("sum", "Součet podle zdroje"),
        new("avg", "Průměr podle zdroje"),
        new("count_if_pq", "Rozklad kvality energie (COUNT IF)"),
        new("balance_pq", "Bilance užitečného vs. parazitního výkonu")
    ];

    private string selectedMetric = "P_avg_3P";
    private string selectedAgg = "sum";

    private bool useTotalThreshold;
    private double totalThreshold = 10000;
    private bool useShareThreshold;
    private string monitoredSource = "EMI1";
    private double shareThresholdPercent = 50;

    private CeaZipStore? store;
    private readonly List<MeterData> meters = [];
    private readonly List<WindowConfig> windows = [];
    private readonly List<ShareTableRow> tableRows = [];
    private readonly List<WhatIfRow> whatIfRows = [];
    private string status = "Čekání…";

    private bool IsSpecialAgg => selectedAgg is "count_if_pq" or "balance_pq";
    private IEnumerable<string> AvailableSources => meters.Select(m => m.Name);

    private async Task LoadAndDraw()
    {
        store = await CeaZipStore.LoadAsync(Http, "sample-data/SMY134aEMIx.cea");

        meters.Clear();

        foreach (var rec in recs)
        {
            var meter = TryLoadMeter(rec);
            if (meter != null)
            {
                meters.Add(meter);
            }
        }

        if (!AvailableSources.Contains(monitoredSource, StringComparer.OrdinalIgnoreCase))
        {
            monitoredSource = AvailableSources.FirstOrDefault() ?? monitoredSource;
        }

        EnsureDefaultWindows();
        await DrawAll();
    }

    private void EnsureDefaultWindows()
    {
        if (windows.Count > 0)
        {
            return;
        }

        var latest = meters.SelectMany(m => m.Table.Time).DefaultIfEmpty(DateTime.Now).Max();

        windows.Add(new WindowConfig
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "Okno 1",
            From = latest.AddMinutes(-5),
            To = latest
        });

        windows.Add(new WindowConfig
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = "Okno 2",
            From = latest.AddMinutes(-30),
            To = latest
        });
    }

    private async Task AddWindow()
    {
        var latest = meters.SelectMany(m => m.Table.Time).DefaultIfEmpty(DateTime.Now).Max();

        windows.Add(new WindowConfig
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = $"Okno {windows.Count + 1}",
            From = latest.AddMinutes(-15),
            To = latest
        });

        await DrawAll();
    }

    private async Task RemoveWindow(string id)
    {
        if (windows.Count <= 1)
        {
            return;
        }

        var index = windows.FindIndex(w => w.Id == id);
        if (index < 0)
        {
            return;
        }

        windows.RemoveAt(index);
        await DrawAll();
    }

    private string GetCanvasId(string windowId) => $"sharePieCanvas_{windowId}";

    private async Task OnMetricChanged(ChangeEventArgs e)
    {
        selectedMetric = e.Value?.ToString() ?? selectedMetric;
        await DrawAll();
    }

    private async Task OnAggChanged(ChangeEventArgs e)
    {
        selectedAgg = e.Value?.ToString() ?? selectedAgg;
        await DrawAll();
    }

    private async Task OnUseTotalThresholdChanged(ChangeEventArgs e)
    {
        useTotalThreshold = (bool?)e.Value == true;
        await DrawAll();
    }

    private async Task OnTotalThresholdChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var x))
        {
            totalThreshold = x;
        }
        await DrawAll();
    }

    private async Task OnUseShareThresholdChanged(ChangeEventArgs e)
    {
        useShareThreshold = (bool?)e.Value == true;
        await DrawAll();
    }

    private async Task OnShareThresholdChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var y))
        {
            shareThresholdPercent = y;
        }
        await DrawAll();
    }

    private async Task OnMonitoredSourceChanged(ChangeEventArgs e)
    {
        monitoredSource = e.Value?.ToString() ?? monitoredSource;
        await DrawAll();
    }

    private async Task ToggleMeter(int meterId, bool isEnabled)
    {
        var meter = meters.FirstOrDefault(m => m.Id == meterId);
        if (meter == null)
        {
            return;
        }

        meter.Enabled = isEnabled;
        await DrawAll();
    }

    private MeterData? TryLoadMeter(Rec rec)
    {
        if (store == null)
        {
            return null;
        }

        var archIds = store.GetArchIds(rec.Id).ToList();
        if (archIds.Count == 0)
        {
            return null;
        }

        var archId = archIds.First();
        var pack = store.GetBinPacks(rec.Id, archId).FirstOrDefault();
        if (pack == null)
        {
            return null;
        }

        var typeXml = store.ReadArchDefXml(rec.Id, archId);
        var columns = ArchDefParser.ParseColumns(typeXml);

        var table = UniArchTableParser.ParseMinuteTable(
            store.Read(pack.Entry),
            pack.TimeUtc.ToLocalTime(),
            periodMs: 60000,
            maxRows: 500);

        table.Columns.Clear();
        table.Columns.AddRange(columns.Take(table.Rows.FirstOrDefault()?.Length ?? 0));

        var indexByName = table.Columns
            .Select((c, i) => new { c.Name, Index = i })
            .GroupBy(x => x.Name)
            .ToDictionary(g => g.Key, g => g.First().Index, StringComparer.OrdinalIgnoreCase);

        var normalizedIndexByName = table.Columns
            .Select((c, i) => new { Name = NormalizeName(c.Name), Index = i })
            .GroupBy(x => x.Name)
            .ToDictionary(g => g.Key, g => g.First().Index, StringComparer.OrdinalIgnoreCase);

        return new MeterData
        {
            Id = rec.Id,
            Name = rec.Name,
            Table = table,
            IndexByName = indexByName,
            NormalizedIndexByName = normalizedIndexByName
        };
    }

    private async Task DrawAll()
    {
        tableRows.Clear();
        whatIfRows.Clear();

        if (meters.Count == 0 || windows.Count == 0)
        {
            return;
        }

        var enabledMeters = meters.Where(m => m.Enabled).ToList();
        if (enabledMeters.Count == 0)
        {
            status = "Vyberte alespoň jeden zdroj.";
            foreach (var w in windows)
            {
                await RenderPie(GetCanvasId(w.Id), [], [], w.Title);
            }
            return;
        }

        var metricSeriesByMeter = enabledMeters.ToDictionary(
            m => m.Name,
            m => BuildMetricSeries(m, selectedMetric).ToList());

        int nonEmptyCount = 0;

        foreach (var window in windows)
        {
            var range = ParseWindowRange(window);
            var title = BuildWindowTitle(window, range);

            var distribution = selectedAgg switch
            {
                "count_if_pq" => BuildPowerQualityBreakdown(enabledMeters, range.From, range.To).ToList(),
                "balance_pq" => BuildPowerBalance(enabledMeters, range.From, range.To).ToList(),
                _ => BuildSourceShare(metricSeriesByMeter, range.From, range.To, out var allowedTimes).ToList()
            };

            if (!IsSpecialAgg)
            {
                _ = BuildSourceShare(metricSeriesByMeter, range.From, range.To, out var allowedTimesWhatIf).ToList();
                if (useShareThreshold)
                {
                    var count = CountShareAboveThreshold(metricSeriesByMeter, allowedTimesWhatIf, monitoredSource, shareThresholdPercent);
                    whatIfRows.Add(new WhatIfRow(title, $"Podíl({monitoredSource}) > {shareThresholdPercent:0.##} %", count, count));
                }
            }

            if (distribution.Count > 0)
            {
                nonEmptyCount++;
            }

            await RenderPie(
                GetCanvasId(window.Id),
                distribution.Select(x => x.Item).ToArray(),
                distribution.Select(x => x.SharePercent).ToArray(),
                title);

            foreach (var row in distribution)
            {
                tableRows.Add(new ShareTableRow(title, range.From, range.To, row.Item, row.Aggregated, row.SharePercent));
            }
        }

        status = nonEmptyCount == 0
            ? "Pro vybranou metriku / interval / sadu zdrojů nejsou data."
            : $"Vykresleno {nonEmptyCount}/{windows.Count} koláčových grafů. Režim: {aggregationOptions.FirstOrDefault(a => a.Key == selectedAgg)?.Label ?? selectedAgg}.";
    }

    private async Task RenderPie(string canvasId, string[] labels, double[] values, string title)
    {
        await JS.InvokeVoidAsync("pieInterop.renderSharePieChart", canvasId, labels, values, title);
    }

    private static (DateTime From, DateTime To) ParseWindowRange(WindowConfig window)
    {
        var from = window.From;
        var to = window.To;
        if (to < from)
        {
            (from, to) = (to, from);
        }

        return (from, to);
    }

    private static string BuildWindowTitle(WindowConfig window, (DateTime From, DateTime To) range)
    {
        var name = string.IsNullOrWhiteSpace(window.Title) ? "Okno" : window.Title.Trim();
        return $"{name}: {range.From:MM-dd HH:mm}..{range.To:HH:mm}";
    }

    private IEnumerable<(DateTime Time, double Value)> BuildMetricSeries(MeterData meter, string metricKey)
    {
        int count = Math.Min(meter.Table.Time.Count, meter.Table.Rows.Count);

        for (int i = 0; i < count; i++)
        {
            var y = ReadMetricValue(meter, i, metricKey);
            if (!y.HasValue)
            {
                continue;
            }

            yield return (meter.Table.Time[i], y.Value);
        }
    }

    private IEnumerable<(string Item, double Aggregated, double SharePercent)> BuildSourceShare(
    Dictionary<string, List<(DateTime Time, double Value)>> seriesByMeter,
    DateTime from,
    DateTime to,
    out HashSet<DateTime> allowedTimes)
    {
        var allPoints = seriesByMeter
            .SelectMany(kvp => kvp.Value.Select(v => (Meter: kvp.Key, v.Time, v.Value)))
            .Where(p => p.Time >= from && p.Time <= to && !double.IsNaN(p.Value) && !double.IsInfinity(p.Value))
            .ToList();

        var groupedTotals = allPoints
            .GroupBy(p => p.Time)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Value));

        allowedTimes = groupedTotals
            .Where(kvp => !useTotalThreshold || kvp.Value > totalThreshold)
            .Select(kvp => kvp.Key)
            .ToHashSet();

        var allowed = allowedTimes;

        var items = seriesByMeter
            .Select(kvp =>
            {
                var values = kvp.Value
                    .Where(point => allowed.Contains(point.Time))
                    .Select(point => point.Value)
                    .Where(v => !double.IsNaN(v) && !double.IsInfinity(v))
                    .ToArray();

                if (values.Length == 0)
                {
                    return (Item: kvp.Key, Aggregated: 0d, Valid: false);
                }

                var agg = selectedAgg == "avg" ? values.Average() : values.Sum();
                return (Item: kvp.Key, Aggregated: Math.Max(agg, 0d), Valid: true);
            })
            .Where(x => x.Valid && x.Aggregated > 0)
            .ToList();

        return ToShares(items.Select(x => (x.Item, x.Aggregated)).ToList());
    }

    private static int CountShareAboveThreshold(
        Dictionary<string, List<(DateTime Time, double Value)>> seriesByMeter,
        HashSet<DateTime> allowedTimes,
        string source,
        double thresholdPercent)
    {
        if (!seriesByMeter.TryGetValue(source, out var sourceSeries))
        {
            return 0;
        }

        var byTime = seriesByMeter
            .SelectMany(kvp => kvp.Value.Select(v => (Meter: kvp.Key, v.Time, v.Value)))
            .Where(v => allowedTimes.Contains(v.Time))
            .GroupBy(v => v.Time)
            .ToDictionary(g => g.Key, g => new
            {
                Total = g.Sum(x => x.Value),
                Source = g.Where(x => x.Meter == source).Select(x => x.Value).FirstOrDefault()
            });

        return byTime
            .Where(kvp => kvp.Value.Total > 0)
            .Count(kvp => (kvp.Value.Source / kvp.Value.Total) * 100d > thresholdPercent);
    }

    private IEnumerable<(string Item, double Aggregated, double SharePercent)> BuildPowerQualityBreakdown(
        List<MeterData> enabledMeters,
        DateTime from,
        DateTime to)
    {
        double thdCount = 0;
        double sagCount = 0;
        double imbalanceCount = 0;

        foreach (var meter in enabledMeters)
        {
            int count = Math.Min(meter.Table.Time.Count, meter.Table.Rows.Count);
            for (int i = 0; i < count; i++)
            {
                var t = meter.Table.Time[i];
                if (t < from || t > to)
                {
                    continue;
                }

                var thd = ReadMetricValue(meter, i, "THDI_3ph_avg");
                if (thd.HasValue && thd.Value > 8.0)
                {
                    thdCount++;
                }

                var u1 = ReadMetricValue(meter, i, "U_avg_U1");
                var u2 = ReadMetricValue(meter, i, "U_avg_U2");
                var u3 = ReadMetricValue(meter, i, "U_avg_U3");
                if ((u1.HasValue && u1.Value < 0.9 * 230.0) ||
                    (u2.HasValue && u2.Value < 0.9 * 230.0) ||
                    (u3.HasValue && u3.Value < 0.9 * 230.0))
                {
                    sagCount++;
                }

                var imbalance = ReadMetricValue(meter, i, "U_phase_imbalance");
                if (imbalance.HasValue && imbalance.Value > 10.0)
                {
                    imbalanceCount++;
                }
            }
        }

        return ToShares([
            ("THD > 8 %", thdCount),
            ("Pokles napětí < 0,9×Unom", sagCount),
            ("Nesymetrie fází", imbalanceCount)
        ]);
    }

    private IEnumerable<(string Item, double Aggregated, double SharePercent)> BuildPowerBalance(
        List<MeterData> enabledMeters,
        DateTime from,
        DateTime to)
    {
        double sumP = 0;
        double sumQ = 0;

        foreach (var meter in enabledMeters)
        {
            int count = Math.Min(meter.Table.Time.Count, meter.Table.Rows.Count);
            for (int i = 0; i < count; i++)
            {
                var t = meter.Table.Time[i];
                if (t < from || t > to)
                {
                    continue;
                }

                var p = ReadMetricValue(meter, i, "P_avg_3P");
                var q = ReadMetricValue(meter, i, "Q_avg_3Q");

                if (p.HasValue && !double.IsNaN(p.Value) && !double.IsInfinity(p.Value))
                {
                    sumP += p.Value;
                }

                if (q.HasValue && !double.IsNaN(q.Value) && !double.IsInfinity(q.Value))
                {
                    sumQ += Math.Abs(q.Value);
                }
            }
        }

        return ToShares([
            ("Užitečný činný výkon P", Math.Max(sumP, 0d)),
            ("Parazitní jalový výkon Q", Math.Max(sumQ, 0d))
        ]);
    }

    private static List<(string Item, double Aggregated, double SharePercent)> ToShares(List<(string Item, double Aggregated)> values)
    {
        var filtered = values.Where(v => v.Aggregated > 0).ToList();
        var total = filtered.Sum(v => v.Aggregated);
        if (total <= 0)
        {
            return [];
        }

        return filtered
            .Select(v => (v.Item, v.Aggregated, SharePercent: (v.Aggregated / total) * 100d))
            .OrderByDescending(v => v.SharePercent)
            .ToList();
    }

    private double? ReadMetricValue(MeterData meter, int rowIndex, string metricKey)
    {
        return metricKey switch
        {
            "I_avg_mean" => Average(meter, rowIndex, "I_avg_I1", "I_avg_I2", "I_avg_I3"),
            "P_to_S_ratio" => RatioPercent(meter, rowIndex, "P_avg_3P", "S_avg_3S"),
            "THDI_3ph_avg" => Average(meter, rowIndex, "Harmonics/THDI_avg_THDI1", "Harmonics/THDI_avg_THDI2", "Harmonics/THDI_avg_THDI3"),
            "U_phase_imbalance" => VoltageImbalancePercent(meter, rowIndex, "U_avg_U1", "U_avg_U2", "U_avg_U3"),
            "S_from_PQ" => SFromPQ(meter, rowIndex),
            "Q_to_P_ratio" => RatioPercent(meter, rowIndex, "Q_avg_3Q", "P_avg_3P"),
            "PQ_incident_flag" => PQIncidentFlag(meter, rowIndex),
            _ => Single(meter, rowIndex, metricKey)
        };
    }

    private double? SFromPQ(MeterData meter, int rowIndex)
    {
        var p = Single(meter, rowIndex, "P_avg_3P");
        var q = Single(meter, rowIndex, "Q_avg_3Q");
        if (!p.HasValue || !q.HasValue)
        {
            return null;
        }

        return Math.Sqrt((p.Value * p.Value) + (q.Value * q.Value));
    }

    private double? PQIncidentFlag(MeterData meter, int rowIndex)
    {
        var thd = ReadMetricValue(meter, rowIndex, "THDI_3ph_avg");
        var imbalance = ReadMetricValue(meter, rowIndex, "U_phase_imbalance");
        var u1 = Single(meter, rowIndex, "U_avg_U1");
        var u2 = Single(meter, rowIndex, "U_avg_U2");
        var u3 = Single(meter, rowIndex, "U_avg_U3");

        bool sag = (u1.HasValue && u1.Value < 0.9 * 230.0) ||
                   (u2.HasValue && u2.Value < 0.9 * 230.0) ||
                   (u3.HasValue && u3.Value < 0.9 * 230.0);

        bool isIncident = (thd.HasValue && thd.Value > 8.0) || sag || (imbalance.HasValue && imbalance.Value > 10.0);
        return isIncident ? 1d : 0d;
    }

    private double? Single(MeterData meter, int rowIndex, string name)
    {
        var idx = ResolveColumnIndex(meter, name);
        if (!idx.HasValue)
        {
            return null;
        }

        if (rowIndex >= meter.Table.Rows.Count || idx.Value >= meter.Table.Rows[rowIndex].Length)
        {
            return null;
        }

        return meter.Table.Rows[rowIndex][idx.Value];
    }

    private int? ResolveColumnIndex(MeterData meter, string name)
    {
        if (meter.IndexByName.TryGetValue(name, out var exact))
        {
            return exact;
        }

        var normalized = NormalizeName(name);
        if (meter.NormalizedIndexByName.TryGetValue(normalized, out var normalizedIndex))
        {
            return normalizedIndex;
        }

        var fallback = meter.NormalizedIndexByName
            .FirstOrDefault(kvp => kvp.Key.EndsWith(normalized, StringComparison.OrdinalIgnoreCase));

        return fallback.Equals(default(KeyValuePair<string, int>)) ? null : fallback.Value;
    }

    private static string NormalizeName(string value)
    {
        return string.Concat(value.Where(ch => char.IsLetterOrDigit(ch) || ch == '_')).ToUpperInvariant();
    }

    private double? Average(MeterData meter, int rowIndex, params string[] names)
    {
        var values = names
            .Select(name => Single(meter, rowIndex, name))
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToArray();

        return values.Length == 0 ? null : values.Average();
    }

    private double? VoltageImbalancePercent(MeterData meter, int rowIndex, params string[] names)
    {
        var values = names
            .Select(name => Single(meter, rowIndex, name))
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToArray();

        if (values.Length == 0)
        {
            return null;
        }

        var avg = values.Average();
        if (Math.Abs(avg) < 0.000001)
        {
            return null;
        }

        var diff = values.Max() - values.Min();
        return (diff / avg) * 100d;
    }

    private double? RatioPercent(MeterData meter, int rowIndex, string numeratorName, string denominatorName)
    {
        var numerator = Single(meter, rowIndex, numeratorName);
        var denominator = Single(meter, rowIndex, denominatorName);

        if (!numerator.HasValue || !denominator.HasValue || Math.Abs(denominator.Value) < 0.000001)
        {
            return null;
        }

        return (numerator.Value / denominator.Value) * 100d;
    }
}
