@page "/sparks"
@inject HttpClient Http

@using System.Globalization
@using DeviceMeasurementsApp.Services
@using DeviceMeasurementsApp.Models

<h3>SkySpark-like Sparks</h3>

<div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:8px;">
    <button @onclick="Load">Load SMY134aEMIx.cea</button>

    @if (store != null)
    {
        @foreach (var r in recs)
        {
            <button @onclick="() => SelectRec(r.Id)">@r.Name</button>
        }
    }
</div>

<p>@status</p>

@if (view != null)
{
    <div style="border:1px solid #ccc; padding:10px; background:#fff;">
        <h4 style="margin:0 0 6px 0;">@view.Title</h4>

        <div style="font-size:12px; color:#666; margin-bottom:10px;">
            @view.From.ToString("dd-MMM-yyyy HH:mm") → @view.To.ToString("dd-MMM-yyyy HH:mm")
        </div>

        <div style="margin-bottom:14px;">
            <div style="font-weight:600; font-size:13px; margin-bottom:6px;">Analog trends</div>
            <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:6px;">
                @foreach (var trend in view.Trends)
                {
                    <div style="font-size:12px; color:#374151; display:flex; align-items:center; gap:6px;">
                        <span style="display:inline-block; width:10px; height:10px; background:@trend.Color; border-radius:2px;"></span>
                        <span>@trend.Label · min: @trend.Min.ToString("0.###", CultureInfo.InvariantCulture), max: @trend.Max.ToString("0.###", CultureInfo.InvariantCulture), last: @trend.Last.ToString("0.###", CultureInfo.InvariantCulture)</span>
                    </div>
                }
            </div>
            <svg viewBox="0 0 1200 200" preserveAspectRatio="none" style="width:100%; height:200px; border:1px solid #e5e7eb; background:#fbfdff;">
                <line x1="0" y1="20" x2="1200" y2="20" stroke="#eef2f7" stroke-width="1"></line>
                <line x1="0" y1="100" x2="1200" y2="100" stroke="#eef2f7" stroke-width="1"></line>
                <line x1="0" y1="180" x2="1200" y2="180" stroke="#eef2f7" stroke-width="1"></line>
                @foreach (var trend in view.Trends)
                {
                    <polyline points="@trend.Points" fill="none" stroke="@trend.Color" stroke-width="2"></polyline>
                }
            </svg>
        </div>

        <div>
            <div style="font-weight:600; font-size:13px; margin-bottom:6px;">State tracks</div>

            @foreach (var track in view.StateTracks)
            {
                <div style="display:grid; grid-template-columns: 260px 1fr; gap:8px; align-items:center; margin-bottom:8px;">
                    <div style="font-size:12px; color:#374151;">@track.Label</div>
                    <div style="position:relative; height:22px; background:#fafafa; border:1px solid #e2e2e2;">
                        @foreach (var seg in track.Segments)
                        {
                            <div style="position:absolute; top:3px; height:14px; border-radius:3px; background:@track.Color; left:@(seg.LeftPercent.ToString("0.###", CultureInfo.InvariantCulture))%; width:@(seg.WidthPercent.ToString("0.###", CultureInfo.InvariantCulture))%;"></div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private sealed record Rec(int Id, string Name);
    private sealed record PercentSegment(double LeftPercent, double WidthPercent);
    private sealed record SparkTrend(string Label, string Color, string Points, double Min, double Max, double Last);
    private sealed record SparkStateTrack(string Label, string Color, List<PercentSegment> Segments);
    private sealed record SparkView(
        string Title,
        DateTime From,
        DateTime To,
        List<SparkTrend> Trends,
        List<SparkStateTrack> StateTracks);
    private sealed record ColumnStat(int Index, string Name, string Label, double Min, double Max, int Distinct, double Variance);

    private readonly List<Rec> recs =
    [
        new(58, "EMI1"),
        new(60, "EMI2"),
        new(59, "EMI3"),
        new(1, "MAIN")
    ];

    private string status = "Waiting…";
    private CeaZipStore? store;
    private UniArchTable? table;
    private SparkView? view;

    private async Task Load()
    {
        store = await CeaZipStore.LoadAsync(Http, "sample-data/SMY134aEMIx.cea");
        table = null;
        view = null;
        status = "Loaded. Select object.";
    }

    private async Task SelectRec(int recId)
    {
        if (store == null)
        {
            return;
        }

        status = $"Loading data for recId={recId}…";

        var archId = store.GetArchIds(recId).First();
        var pack = store.GetBinPacks(recId, archId).First();

        table = UniArchTableParser.ParseMinuteTable(
            store.Read(pack.Entry),
            pack.TimeUtc.ToLocalTime(),
            periodMs: 60000,
            maxRows: 720);

        var typeXml = store.ReadArchDefXml(recId, archId);
        var columns = ArchDefParser.ParseColumns(typeXml);
        if (columns.Count > 0)
        {
            table.Columns.Clear();
            table.Columns.AddRange(columns.Take(table.Rows.FirstOrDefault()?.Length ?? 0));
        }

        BuildView();
        status = view == null ? "No data to display." : $"Rendered {table.Rows.Count} points.";

        await Task.CompletedTask;
    }

    private void BuildView()
    {
        if (table == null || table.Rows.Count == 0 || table.Time.Count < 2)
        {
            view = null;
            return;
        }

        var columns = Enumerable.Range(0, table.Columns.Count)
            .Select(c => new ColumnStat(
                c,
                table.Columns[c].Name,
                table.Columns[c].DisplayName,
                table.Rows.Min(r => (double)r[c]),
                table.Rows.Max(r => (double)r[c]),
                table.Rows.Select(r => Math.Round((double)r[c], 2)).Distinct().Count(),
                CalculateVariance(c)))
            .ToList();

        var analogColumns = columns
            .Where(c => c.Name.Contains("P_avg", StringComparison.OrdinalIgnoreCase))
            .Take(4)
            .ToList();

        if (analogColumns.Count == 0)
        {
            analogColumns = columns
                .Where(c => c.Max - c.Min > 0.01)
                .OrderByDescending(c => c.Variance)
                .Take(4)
                .ToList();
        }

        if (analogColumns.Count == 0)
        {
            view = null;
            return;
        }

        var trendColors = new[] { "#4f7edb", "#2ba297", "#d07a36", "#8b5cf6" };
        var trends = analogColumns
            .Select((c, i) => new SparkTrend(
                c.Label,
                trendColors[i % trendColors.Length],
                BuildPolylinePoints(c.Index, c.Min, c.Max),
                c.Min,
                c.Max,
                (double)table.Rows.Last()[c.Index]))
            .ToList();

        var stateTracks = BuildDerivedStateTracks(columns);

        view = new SparkView(
            Title: $"Sparks • {table.Time.First():dd-MMM-yyyy HH:mm} - {table.Time.Last():HH:mm}",
            From: table.Time.First(),
            To: table.Time.Last(),
            Trends: trends,
            StateTracks: stateTracks);
    }

    private List<SparkStateTrack> BuildDerivedStateTracks(List<ColumnStat> columns)
    {
        var tracks = new List<SparkStateTrack>();

        int? p3p = FindColumnIndex("P_avg_3P", columns);
        int? i1 = FindColumnIndex("I_avg_I1", columns);
        int? q3q = FindColumnIndex("Q_avg_3Q", columns);
        int? u1 = FindColumnIndex("U_avg_U1", columns);
        int? u2 = FindColumnIndex("U_avg_U2", columns);
        int? u3 = FindColumnIndex("U_avg_U3", columns);

        if (p3p.HasValue)
        {
            var thr = Quantile(p3p.Value, 0.85);
            tracks.Add(new SparkStateTrack("High demand (P_avg_3P > P85)", "#f59e0b", BuildSegmentsByPredicate(i => table!.Rows[i][p3p.Value] >= thr)));
        }

        if (i1.HasValue)
        {
            var thr = Quantile(i1.Value, 0.85);
            tracks.Add(new SparkStateTrack("Current surge (I_avg_I1 > P85)", "#0ea5a4", BuildSegmentsByPredicate(i => table!.Rows[i][i1.Value] >= thr)));
        }

        if (q3q.HasValue)
        {
            var thr = Quantile(q3q.Value, 0.15);
            tracks.Add(new SparkStateTrack("Reactive dip (Q_avg_3Q < P15)", "#ef4444", BuildSegmentsByPredicate(i => table!.Rows[i][q3q.Value] <= thr)));
        }

        if (u1.HasValue && u2.HasValue && u3.HasValue)
        {
            var imbalances = Enumerable.Range(0, table!.Rows.Count)
                .Select(i =>
                {
                    var a = (double)table.Rows[i][u1.Value];
                    var b = (double)table.Rows[i][u2.Value];
                    var c = (double)table.Rows[i][u3.Value];
                    return Math.Max(a, Math.Max(b, c)) - Math.Min(a, Math.Min(b, c));
                })
                .ToArray();
            var sorted = imbalances.OrderBy(x => x).ToArray();
            var idx = Math.Clamp((int)(sorted.Length * 0.85), 0, sorted.Length - 1);
            var thr = sorted[idx];
            tracks.Add(new SparkStateTrack("Voltage imbalance (maxΔU > P85)", "#3b82f6", BuildSegmentsByPredicate(i =>
            {
                var a = (double)table!.Rows[i][u1.Value];
                var b = (double)table.Rows[i][u2.Value];
                var c = (double)table.Rows[i][u3.Value];
                return (Math.Max(a, Math.Max(b, c)) - Math.Min(a, Math.Min(b, c))) >= thr;
            })));
        }

        if (tracks.Count == 0)
        {
            var fallback = columns
                .Where(c => c.Distinct <= 8 && c.Max - c.Min > 0.001)
                .OrderBy(c => c.Index)
                .Take(4)
                .ToList();

            if (fallback.Count == 0)
            {
                fallback = columns.OrderByDescending(c => c.Variance).Take(3).ToList();
            }

            tracks.AddRange(fallback.Select((c, i) =>
                new SparkStateTrack(c.Label, StateColor(i), BuildStateSegments(c.Index, c.Min, c.Max))));
        }

        return tracks;
    }

    private int? FindColumnIndex(string namePart, List<ColumnStat> columns)
    {
        var hit = columns.FirstOrDefault(c => c.Name.Contains(namePart, StringComparison.OrdinalIgnoreCase));
        if (hit == null)
        {
            return null;
        }

        return hit.Index;
    }

    private double Quantile(int column, double q)
    {
        var values = table!.Rows.Select(r => (double)r[column]).OrderBy(v => v).ToArray();
        int idx = Math.Clamp((int)(values.Length * q), 0, values.Length - 1);
        return values[idx];
    }

    private string BuildPolylinePoints(int column, double min, double max)
    {
        if (table == null || table.Rows.Count == 0)
        {
            return string.Empty;
        }

        double span = Math.Max(0.000001, max - min);
        int n = table.Rows.Count;
        var points = new List<string>(n);

        for (int i = 0; i < n; i++)
        {
            double x = n <= 1 ? 0 : i * 1200d / (n - 1);
            double value = table.Rows[i][column];
            double normalized = (value - min) / span;
            double y = 180 - (normalized * 160d);

            points.Add($"{x.ToString("0.###", CultureInfo.InvariantCulture)},{y.ToString("0.###", CultureInfo.InvariantCulture)}");
        }

        return string.Join(" ", points);
    }

    private List<PercentSegment> BuildStateSegments(int column, double min, double max)
    {
        if (table == null || table.Rows.Count == 0)
        {
            return [];
        }

        double threshold = min + (max - min) * 0.5;
        return BuildSegmentsByPredicate(i => table.Rows[i][column] >= threshold);
    }


    private List<PercentSegment> BuildSegmentsByPredicate(Func<int, bool> isOn)
    {
        if (table == null || table.Rows.Count == 0)
        {
            return [];
        }

        int n = table.Rows.Count;
        var raw = new List<(int Start, int End)>();
        bool inSegment = false;
        int start = 0;

        for (int i = 0; i < n; i++)
        {
            if (isOn(i) && !inSegment)
            {
                inSegment = true;
                start = i;
            }
            else if (!isOn(i) && inSegment)
            {
                inSegment = false;
                raw.Add((start, i));
            }
        }

        if (inSegment)
        {
            raw.Add((start, n - 1));
        }

        var result = new List<PercentSegment>(raw.Count);

        foreach (var (segStart, segEnd) in raw)
        {
            double left = segStart * 100d / Math.Max(1, n - 1);
            double right = segEnd * 100d / Math.Max(1, n - 1);
            double width = Math.Max(0.35, right - left);
            result.Add(new PercentSegment(left, width));
        }

        return result;
    }

    private double CalculateVariance(int column)
    {
        if (table == null || table.Rows.Count == 0)
        {
            return 0;
        }

        var values = table.Rows.Select(r => (double)r[column]).ToArray();
        var avg = values.Average();
        return values.Select(v => Math.Pow(v - avg, 2)).Average();
    }

    private static string StateColor(int index) =>
        index switch
        {
            0 => "#2ca25f",
            1 => "#3182bd",
            2 => "#f16913",
            3 => "#756bb1",
            _ => "#0ea5a4"
        };
}
