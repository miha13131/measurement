@page "/meter-analysis"
@inject HttpClient Http
@inject IJSRuntime JS

@using DeviceMeasurementsApp.Models
@using DeviceMeasurementsApp.Services

<h3>Trend měřičů</h3>

<div style="margin-bottom:10px; font-size:13px; color:#374151;">
    <strong>Přehled metrik:</strong>
    <ul style="margin:6px 0 0 18px;">
        <li><strong>P_avg_3P</strong> — celkový činný výkon (reálně využitý výkon) [W].</li>
        <li><strong>S_avg_3S</strong> — celkový zdánlivý výkon (činná + jalová složka) [VA].</li>
        <li><strong>I_avg_mean</strong> — průměrný proud tří fází ((I1+I2+I3)/3) [A].</li>
        <li><strong>PF_3PF</strong> — celkový účiník; čím blíže 1, tím efektivnější provoz [-].</li>
        <li><strong>Cos_3Cosφ</strong> — cos φ, tedy fázový posun mezi napětím a proudem [-].</li>
        <li><strong>f_avg_f</strong> — frekvence sítě [Hz].</li>
        <li><strong>THDI_3ph_avg</strong> — průměrné harmonické zkreslení proudu ve 3 fázích [%].</li>
        <li><strong>U_phase_imbalance</strong> — nesymetrie fázového napětí (max(U1,U2,U3)-min(...)) [V].</li>
        <li><strong>P_to_S_ratio</strong> — poměr zatížení výkonu (P_avg_3P / S_avg_3S * 100) [%].</li>
        <li><strong>U_avg_LL</strong> — průměrné sdružené napětí L-L ((U12+U23+U31)/3) [V].</li>
    </ul>
</div>

<div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:8px;">
    <button @onclick="LoadAndDraw">Načíst + vykreslit</button>

    <label>Max. řádků:</label>
    <input type="number" min="500" max="200000" step="500" @bind="maxRowsToLoad" style="width:120px;" />

    <label>Metrika:</label>
    <select @onchange="OnSignalChanged" disabled="@(meters.Count == 0)">
        @foreach (var s in signals)
        {
            <option value="@s.Key" selected="@(s.Key == selectedSignal)">@s.Label</option>
        }
    </select>

    <label>Režim agregace:</label>
    <select @onchange="OnAggregationChanged" disabled="@(meters.Count == 0)">
        @foreach (var option in aggregationOptions)
        {
            <option value="@option.Key" selected="@(option.Key == selectedAggregation)">@option.Label</option>
        }
    </select>

    <label>
        <input type="checkbox" checked="@showRawMeters" @onchange="OnShowRawChanged" />
        Surové měřiče
    </label>
</div>

@if (meters.Count > 0)
{
    <div style="margin-bottom:10px; padding:10px; border:1px solid #d1d5db; background:#f9fafb;">
        <strong>Nejprve přehled: zoom a filtr</strong>

        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:8px;">
            <label>Od:</label>
            <input type="datetime-local" @bind-value="filterFrom" @bind-value:format="yyyy-MM-ddTHH:mm" />

            <label>Do:</label>
            <input type="datetime-local" @bind-value="filterTo" @bind-value:format="yyyy-MM-ddTHH:mm" />

            <button @onclick="ApplyDateFilter">Použít filtr</button>
            <button @onclick="ResetDateFilter">Reset</button>
        </div>

        <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:8px;">
            <label>Začátek zoomu %</label>
            <input type="range" min="0" max="100" step="1" value="@zoomStartPercent" @oninput="OnZoomStartChanged" />
            <span>@zoomStartPercent%</span>

            <label>Konec zoomu %</label>
            <input type="range" min="0" max="100" step="1" value="@zoomEndPercent" @oninput="OnZoomEndChanged" />
            <span>@zoomEndPercent%</span>
        </div>
    </div>
}

@if (meters.Count > 0)
{
    <div style="margin-bottom:10px;">
        @foreach (var meter in meters)
        {
            <label style="margin-right:12px;">
                <input type="checkbox" checked="@meter.Enabled" @onchange="(e => ToggleMeter(meter.Id, (bool?)e.Value == true))" />
                @meter.Name
            </label>
        }
    </div>
}

<p>@status</p>

@if (meters.Count > 0)
{
    <div style="height:680px; border:1px solid #d6d9df; background:#fafafa; padding:8px;">
        <canvas id="meterCompareCanvas"></canvas>
    </div>
}

@if (summaryRows.Count > 0)
{
    <h5 style="margin-top:14px;">Náhled agregace (posledních 12 bodů)</h5>
    <div style="overflow:auto; max-height:320px; border:1px solid #ddd; background:white;">
        <table class="table table-sm table-striped" style="margin-bottom:0;">
            <thead>
                <tr>
                    <th>Čas</th>
                    @foreach (var meterName in activeMeterNames)
                    {
                        <th>@meterName</th>
                    }
                    <th>@CurrentAggregationLabel</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in summaryRows)
                {
                    <tr>
                        <td>@row.Time.ToString("yyyy-MM-dd HH:mm")</td>
                        @foreach (var meterName in activeMeterNames)
                        {
                            if (row.MeterValues.TryGetValue(meterName, out var value))
                            {
                                <td>@value.ToString("0.###")</td>
                            }
                            else
                            {
                                <td>—</td>
                            }
                        }
                        <td>@row.AggregatedValue.ToString("0.###")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (detailSnapshot is not null)
{
    <h5 style="margin-top:14px;">Detail na vyžádání</h5>
    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:8px;">
        <label>Čas:</label>
        <input type="datetime-local" @bind-value="detailTime" @bind-value:format="yyyy-MM-ddTHH:mm" />
        <button @onclick="RefreshDetails">Zobrazit detail</button>
    </div>

    <div style="overflow:auto; max-height:260px; border:1px solid #ddd; background:white;">
        <table class="table table-sm table-striped" style="margin-bottom:0;">
            <thead>
                <tr>
                    <th>Čas</th>
                    @foreach (var meterName in activeMeterNames)
                    {
                        <th>@meterName</th>
                    }
                    <th>@CurrentAggregationLabel</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@detailSnapshot.Time.ToString("yyyy-MM-dd HH:mm")</td>
                    @foreach (var meterName in activeMeterNames)
                    {
                        if (detailSnapshot.MeterValues.TryGetValue(meterName, out var meterValue))
                        {
                            <td>@meterValue.ToString("0.###")</td>
                        }
                        else
                        {
                            <td>—</td>
                        }
                    }
                    <td>@(detailSnapshot.AggregatedValue?.ToString("0.###") ?? "—")</td>
                </tr>
            </tbody>
        </table>
    </div>
}

@code {
    private sealed record Rec(int Id, string Name);
    private sealed record Signal(string Key, string Label, string YAxis);
    private sealed record AggregationOption(string Key, string Label);

    private sealed class MeterData
    {
        public int Id { get; init; }
        public string Name { get; init; } = string.Empty;
        public bool Enabled { get; set; } = true;
        public required UniArchTable Table { get; init; }
        public required Dictionary<string, int> IndexByName { get; init; }
        public required Dictionary<string, int> NormalizedIndexByName { get; init; }
    }

    private sealed record AggregationRow(DateTime Time, Dictionary<string, double> MeterValues, double AggregatedValue);
    private sealed record DetailSnapshot(DateTime Time, Dictionary<string, double> MeterValues, double? AggregatedValue);

    private readonly List<Rec> recs =
    [
        new(58, "EMI1"),
        new(60, "EMI2"),
        new(59, "EMI3"),
        new(1, "MAIN")
    ];

    private readonly List<Signal> signals =
    [
        new("P_avg_3P", "Celkový činný výkon (P_avg_3P)", "Výkon [W]"),
        new("P_avg_P1", "Činný výkon L1 (P_avg_P1)", "Výkon [W]"),
        new("P_avg_P2", "Činný výkon L2 (P_avg_P2)", "Výkon [W]"),
        new("P_avg_P3", "Činný výkon L3 (P_avg_P3)", "Výkon [W]"),
        new("Q_avg_3Q", "Celkový jalový výkon (Q_avg_3Q)", "Jalový výkon [var]"),
        new("S_avg_3S", "Celkový zdánlivý výkon (S_avg_3S)", "Zdánlivý výkon [VA]"),
        new("I_avg_mean", "Průměrný proud 3 fází ((I1+I2+I3)/3)", "Proud [A]"),
        new("PF_3PF", "Celkový účiník (PF_3PF)", "Účiník"),
        new("Cos_3Cosφ", "Celkové cos φ (Cos_3Cosφ)", "Cos φ"),
        new("f_avg_f", "Frekvence (f_avg_f)", "Frekvence [Hz]"),
        new("THDI_3ph_avg", "Průměrné THDI 3 fází ((THDI1+THDI2+THDI3)/3)", "THDI [%]"),
        new("U_phase_imbalance", "Nesymetrie fázového napětí (max(U1,U2,U3)-min(...))", "Nesymetrie napětí [V]"),
        new("P_to_S_ratio", "Poměr zatížení výkonu (P_avg_3P / S_avg_3S * 100)", "Zatížení [%]"),
        new("U_avg_U1", "Napětí L1 (U_avg_U1)", "Napětí [V]"),
        new("U_avg_U2", "Napětí L2 (U_avg_U2)", "Napětí [V]"),
        new("U_avg_U3", "Napětí L3 (U_avg_U3)", "Napětí [V]"),
        new("U_avg_LL", "Průměrné sdružené napětí L-L ((U12+U23+U31)/3)", "Napětí [V]")
    ];

    private readonly List<AggregationOption> aggregationOptions =
    [
        new("none", "Bez agregace"),
        new("sum", "Součet"),
        new("avg", "Průměr"),
        new("min", "Minimum"),
        new("max", "Maximum")
    ];

    private string selectedSignal = "P_avg_3P";
    private string selectedAggregation = "sum";
    private bool showRawMeters = true;
    private string status = "…";
    private int maxRowsToLoad = 10000;

    private CeaZipStore? store;
    private readonly List<MeterData> meters = [];

    private readonly List<AggregationRow> summaryRows = [];
    private List<string> activeMeterNames = [];
    private DetailSnapshot? detailSnapshot;

    private DateTime? filterFrom;
    private DateTime? filterTo;
    private int zoomStartPercent = 0;
    private int zoomEndPercent = 100;
    private DateTime? detailTime;

    private string CurrentAggregationLabel => aggregationOptions.FirstOrDefault(x => x.Key == selectedAggregation)?.Label ?? "Agregace";

    private async Task LoadAndDraw()
    {
        store = await CeaZipStore.LoadAsync(Http, "sample-data/SMY134aEMIx.cea");

        meters.Clear();

        foreach (var rec in recs)
        {
            var meter = TryLoadMeter(rec);
            if (meter != null)
            {
                meters.Add(meter);
            }
        }

        await DrawChart();
    }

    private MeterData? TryLoadMeter(Rec rec)
    {
        if (store == null)
        {
            return null;
        }

        var archIds = store.GetArchIds(rec.Id).ToList();
        if (archIds.Count == 0)
        {
            return null;
        }

        var archId = archIds.First();
        var pack = store.GetBinPacks(rec.Id, archId).FirstOrDefault();
        if (pack == null)
        {
            return null;
        }

        var typeXml = store.ReadArchDefXml(rec.Id, archId);
        var columns = ArchDefParser.ParseColumns(typeXml);

        var table = UniArchTableParser.ParseMinuteTable(
            store.Read(pack.Entry),
            pack.TimeUtc.ToLocalTime(),
            periodMs: 60000,
            maxRows: Math.Clamp(maxRowsToLoad, 500, 200000));

        table.Columns.Clear();
        table.Columns.AddRange(columns.Take(table.Rows.FirstOrDefault()?.Length ?? 0));

        var indexByName = table.Columns
            .Select((c, i) => new { c.Name, Index = i })
            .GroupBy(x => x.Name)
            .ToDictionary(g => g.Key, g => g.First().Index, StringComparer.OrdinalIgnoreCase);

        var normalizedIndexByName = table.Columns
            .Select((c, i) => new { Name = NormalizeName(c.Name), Index = i })
            .GroupBy(x => x.Name)
            .ToDictionary(g => g.Key, g => g.First().Index, StringComparer.OrdinalIgnoreCase);

        return new MeterData
        {
            Id = rec.Id,
            Name = rec.Name,
            Table = table,
            IndexByName = indexByName,
            NormalizedIndexByName = normalizedIndexByName
        };
    }

    private async Task OnSignalChanged(ChangeEventArgs e)
    {
        selectedSignal = e.Value?.ToString() ?? selectedSignal;
        await DrawChart();
    }

    private async Task OnAggregationChanged(ChangeEventArgs e)
    {
        selectedAggregation = e.Value?.ToString() ?? selectedAggregation;
        await DrawChart();
    }

    private async Task OnShowRawChanged(ChangeEventArgs e)
    {
        showRawMeters = (bool?)e.Value == true;
        await DrawChart();
    }

    private async Task ToggleMeter(int meterId, bool isEnabled)
    {
        var meter = meters.FirstOrDefault(m => m.Id == meterId);
        if (meter == null)
        {
            return;
        }

        meter.Enabled = isEnabled;
        await DrawChart();
    }

    private async Task DrawChart()
    {
        summaryRows.Clear();
        activeMeterNames = [];
        detailSnapshot = null;

        if (meters.Count == 0)
        {
            return;
        }

        string[] colors = ["#2f7ed8", "#8bbc21", "#910000", "#1aadce", "#492970"];
        int colorIndex = 0;

        var enabledMeters = meters.Where(m => m.Enabled).ToList();
        activeMeterNames = enabledMeters.Select(m => m.Name).ToList();

        var rawSeries = enabledMeters.ToDictionary(
            m => m.Name,
            m => BuildPoints(m).ToList());

        var datasets = new List<object>();

        if (showRawMeters)
        {
            foreach (var meter in enabledMeters)
            {
                var points = rawSeries[meter.Name]
                    .Select(p => new { x = p.X, y = p.Y })
                    .ToArray();

                if (points.Length == 0)
                {
                    continue;
                }

                var color = colors[colorIndex++ % colors.Length];

                datasets.Add(new
                {
                    label = meter.Name,
                    borderColor = color,
                    backgroundColor = color,
                    data = points
                });
            }
        }

        var aggregated = BuildAggregatedSeries(rawSeries, selectedAggregation).ToList();
        if (aggregated.Count > 0)
        {
            datasets.Add(new
            {
                label = $"AGG: {CurrentAggregationLabel}",
                borderColor = "#111827",
                backgroundColor = "#111827",
                borderDash = new[] { 7, 4 },
                borderWidth = 3,
                data = aggregated.Select(p => new { x = p.Time, y = p.Value }).ToArray()
            });

            summaryRows.AddRange(aggregated
                .TakeLast(12)
                .Select(x => new AggregationRow(x.Time, x.MeterValues, x.Value)));
        }

        var yAxis = signals.First(s => s.Key == selectedSignal).YAxis;

        await JS.InvokeVoidAsync(
            "chartInterop.renderMultiTimeSeriesChart",
            "meterCompareCanvas",
            datasets,
            yAxis);

        if (datasets.Count == 0)
        {
            status = "Pro vybranou metriku/agregaci nejsou data.";
            return;
        }

        var availableTimes = rawSeries.Values
            .SelectMany(s => s)
            .Select(p => p.X)
            .OrderBy(t => t)
            .ToList();

        if (availableTimes.Count == 0)
        {
            status = "Ve zvoleném časovém okně nejsou žádné body.";
            return;
        }

        EnsureFilterBounds(availableTimes.First(), availableTimes.Last());
        InitializeDetailTime(rawSeries);
        RefreshDetailsFromSeries(rawSeries);

        status = $"Vykresleno: {datasets.Count} sérií, bodů: {availableTimes.Count}. Rozsah dat: {availableTimes.First():yyyy-MM-dd HH:mm} .. {availableTimes.Last():yyyy-MM-dd HH:mm}.";
    }

    private IEnumerable<(DateTime X, double Y)> BuildPoints(MeterData meter)
    {
        int count = Math.Min(meter.Table.Time.Count, meter.Table.Rows.Count);
        var from = filterFrom ?? meter.Table.Time.FirstOrDefault();
        var to = filterTo ?? meter.Table.Time.LastOrDefault();

        for (int i = 0; i < count; i++)
        {
            var time = meter.Table.Time[i];
            if (time < from || time > to)
            {
                continue;
            }

            var y = ReadSignalValue(meter, i);
            if (!y.HasValue)
            {
                continue;
            }

            yield return (time, y.Value);
        }
    }

    private IEnumerable<(DateTime Time, double Value, Dictionary<string, double> MeterValues)> BuildAggregatedSeries(
        Dictionary<string, List<(DateTime X, double Y)>> rawSeries,
        string aggregationKey)
    {
        if (aggregationKey == "none")
        {
            return [];
        }

        var grouped = rawSeries
            .SelectMany(kvp => kvp.Value.Select(p => new { Meter = kvp.Key, p.X, p.Y }))
            .GroupBy(x => x.X)
            .OrderBy(g => g.Key)
            .ToList();

        var result = new List<(DateTime, double, Dictionary<string, double>)>();

        foreach (var g in grouped)
        {
            var values = g.Select(x => x.Y).ToArray();
            if (values.Length == 0)
            {
                continue;
            }

            double agg = aggregationKey switch
            {
                "sum" => values.Sum(),
                "avg" => values.Average(),
                "min" => values.Min(),
                "max" => values.Max(),
                _ => values.Average()
            };

            var meterMap = g.ToDictionary(x => x.Meter, x => x.Y);
            result.Add((g.Key, agg, meterMap));
        }

        return result;
    }

    private double? ReadSignalValue(MeterData meter, int rowIndex)
    {
        return selectedSignal switch
        {
            "U_avg_LL" => Average(meter, rowIndex, "U_avg_U12", "U_avg_U23", "U_avg_U31"),
            "I_avg_mean" => Average(meter, rowIndex, "I_avg_I1", "I_avg_I2", "I_avg_I3"),
            "THDI_3ph_avg" => Average(meter, rowIndex, "Harmonics/THDI_avg_THDI1", "Harmonics/THDI_avg_THDI2", "Harmonics/THDI_avg_THDI3"),
            "U_phase_imbalance" => Range(meter, rowIndex, "U_avg_U1", "U_avg_U2", "U_avg_U3"),
            "P_to_S_ratio" => RatioPercent(meter, rowIndex, "P_avg_3P", "S_avg_3S"),
            _ => Single(meter, rowIndex, selectedSignal)
        };
    }

    private double? Single(MeterData meter, int rowIndex, string name)
    {
        var idx = ResolveColumnIndex(meter, name);
        if (!idx.HasValue)
        {
            return null;
        }

        if (rowIndex >= meter.Table.Rows.Count || idx.Value >= meter.Table.Rows[rowIndex].Length)
        {
            return null;
        }

        return meter.Table.Rows[rowIndex][idx.Value];
    }

    private int? ResolveColumnIndex(MeterData meter, string name)
    {
        if (meter.IndexByName.TryGetValue(name, out var exact))
        {
            return exact;
        }

        var normalized = NormalizeName(name);
        if (meter.NormalizedIndexByName.TryGetValue(normalized, out var normalizedIndex))
        {
            return normalizedIndex;
        }

        var fallback = meter.NormalizedIndexByName
            .FirstOrDefault(kvp => kvp.Key.EndsWith(normalized, StringComparison.OrdinalIgnoreCase));

        return fallback.Equals(default(KeyValuePair<string, int>)) ? null : fallback.Value;
    }

    private static string NormalizeName(string value)
    {
        return string.Concat(value.Where(ch => char.IsLetterOrDigit(ch) || ch == '_')).ToUpperInvariant();
    }

    private double? Average(MeterData meter, int rowIndex, params string[] names)
    {
        var values = names
            .Select(name => Single(meter, rowIndex, name))
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToArray();

        return values.Length == 0 ? null : values.Average();
    }

    private double? Range(MeterData meter, int rowIndex, params string[] names)
    {
        var values = names
            .Select(name => Single(meter, rowIndex, name))
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToArray();

        return values.Length == 0 ? null : values.Max() - values.Min();
    }

    private double? RatioPercent(MeterData meter, int rowIndex, string numeratorName, string denominatorName)
    {
        var numerator = Single(meter, rowIndex, numeratorName);
        var denominator = Single(meter, rowIndex, denominatorName);

        if (!numerator.HasValue || !denominator.HasValue || Math.Abs(denominator.Value) < 0.000001)
        {
            return null;
        }

        return (numerator.Value / denominator.Value) * 100d;
    }

    private Task ApplyDateFilter() => DrawChart();

    private async Task ResetDateFilter()
    {
        var allTimes = meters
            .SelectMany(m => m.Table.Time)
            .OrderBy(t => t)
            .ToList();

        if (allTimes.Count == 0)
        {
            return;
        }

        filterFrom = allTimes.First();
        filterTo = allTimes.Last();
        zoomStartPercent = 0;
        zoomEndPercent = 100;

        await DrawChart();
    }

    private async Task OnZoomStartChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
        {
            return;
        }

        zoomStartPercent = Math.Clamp(value, 0, 99);
        if (zoomStartPercent >= zoomEndPercent)
        {
            zoomEndPercent = Math.Min(100, zoomStartPercent + 1);
        }

        await ApplyZoomByPercent();
    }

    private async Task OnZoomEndChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
        {
            return;
        }

        zoomEndPercent = Math.Clamp(value, 1, 100);
        if (zoomEndPercent <= zoomStartPercent)
        {
            zoomStartPercent = Math.Max(0, zoomEndPercent - 1);
        }

        await ApplyZoomByPercent();
    }

    private async Task ApplyZoomByPercent()
    {
        var allTimes = meters
            .SelectMany(m => m.Table.Time)
            .OrderBy(t => t)
            .ToList();

        if (allTimes.Count == 0)
        {
            return;
        }

        var first = allTimes.First();
        var last = allTimes.Last();
        var totalTicks = Math.Max(1, last.Ticks - first.Ticks);

        var fromTicks = first.Ticks + (long)(totalTicks * (zoomStartPercent / 100d));
        var toTicks = first.Ticks + (long)(totalTicks * (zoomEndPercent / 100d));

        if (fromTicks >= toTicks)
        {
            toTicks = fromTicks + TimeSpan.FromMinutes(1).Ticks;
        }

        filterFrom = new DateTime(fromTicks);
        filterTo = new DateTime(toTicks);

        await DrawChart();
    }

    private void EnsureFilterBounds(DateTime from, DateTime to)
    {
        if (!filterFrom.HasValue)
        {
            filterFrom = from;
        }

        if (!filterTo.HasValue)
        {
            filterTo = to;
        }
    }

    private void InitializeDetailTime(Dictionary<string, List<(DateTime X, double Y)>> rawSeries)
    {
        var timeline = rawSeries.Values
            .SelectMany(x => x.Select(p => p.X))
            .Distinct()
            .OrderBy(t => t)
            .ToList();

        if (timeline.Count == 0)
        {
            detailTime = null;
            return;
        }

        if (!detailTime.HasValue)
        {
            detailTime = timeline.Last();
        }
    }

    private Task RefreshDetails()
    {
        var enabledMeters = meters.Where(m => m.Enabled).ToList();
        var rawSeries = enabledMeters.ToDictionary(
            m => m.Name,
            m => BuildPoints(m).ToList());

        RefreshDetailsFromSeries(rawSeries);
        return Task.CompletedTask;
    }

    private void RefreshDetailsFromSeries(Dictionary<string, List<(DateTime X, double Y)>> rawSeries)
    {
        var timeline = rawSeries.Values
            .SelectMany(s => s.Select(p => p.X))
            .Distinct()
            .OrderBy(t => t)
            .ToList();

        if (timeline.Count == 0)
        {
            detailSnapshot = null;
            return;
        }

        var target = detailTime ?? timeline.Last();
        var nearest = timeline.OrderBy(t => Math.Abs((t - target).Ticks)).First();

        var meterValues = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        foreach (var (name, points) in rawSeries)
        {
            var point = points.FirstOrDefault(p => p.X == nearest);
            if (point != default)
            {
                meterValues[name] = point.Y;
            }
        }

        double? aggregate = null;
        if (selectedAggregation != "none")
        {
            var aggregated = BuildAggregatedSeries(rawSeries, selectedAggregation).FirstOrDefault(x => x.Time == nearest);
            aggregate = aggregated.Value;
        }

        detailSnapshot = new DetailSnapshot(nearest, meterValues, aggregate);
    }

}
